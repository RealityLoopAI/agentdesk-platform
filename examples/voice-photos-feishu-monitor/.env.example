# Mount smb://192.168.66.149/video_database/voice_photos read-only first.
VOICE_PHOTOS_ROOT=/Volumes/video_database/voice_photos
VOICE_PHOTOS_STATE_DB=/absolute/writable/path/voice-photos-monitor.sqlite
VOICE_PHOTOS_FEISHU_TARGET=feishu:p2p:ou_xxx

# Reuse the RealityLoop bot application credentials. Never commit real values.
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace-me
FEISHU_BASE_URL=https://open.feishu.cn

# Safe defaults shown explicitly for operators.
VOICE_PHOTOS_POLL_INTERVAL_MS=5000
VOICE_PHOTOS_STABILITY_SCANS=2
VOICE_PHOTOS_MAX_IMAGE_BYTES=20971520
VOICE_PHOTOS_MAX_CANDIDATES_PER_SCAN=100000
VOICE_PHOTOS_DELIVERY_CONCURRENCY=1
VOICE_PHOTOS_MAX_SENDS_PER_MINUTE=30
VOICE_PHOTOS_RETRY_BASE_MS=1000
VOICE_PHOTOS_RETRY_MAX_MS=300000
VOICE_PHOTOS_SENDING_LEASE_MS=60000
VOICE_PHOTOS_OWNER_LEASE_MS=30000
VOICE_PHOTOS_SHUTDOWN_DEADLINE_MS=10000
