# Mount the SMB folder read-only on the Host first. The image path preserves
# the original fixed-RealityLoop P2P behavior.
VOICE_PHOTOS_IMAGE_MONITOR_ENABLED=true
VOICE_PHOTOS_ROOT=/Volumes/video_database/voice_photos
VOICE_PHOTOS_STATE_DB=/absolute/writable/path/voice-photos-images.sqlite
VOICE_PHOTOS_FEISHU_TARGET=feishu:p2p:ou_replace_me

# Existing RealityLoop bot credentials used only for image upload/delivery.
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me
FEISHU_BASE_URL=https://open.feishu.cn

# JSON ingestion is independent and disabled by default.
VOICE_PHOTOS_JSON_MONITOR_ENABLED=false
VOICE_PHOTOS_JSON_STATE_DB=/absolute/writable/path/voice-photo-json-v1.sqlite

# Trusted Host binding and dedicated machine messaging-group route.
VOICE_PHOTOS_AUTHENTICATED_USER_ID=usr_replace_me
VOICE_PHOTOS_PLATFORM_ID=voice-photo-json:realityloop
# Closed scene -> logical resource/field mapping. Physical Bitable IDs remain
# only in FEISHU_BITABLE_RESOURCES_JSON.
VOICE_PHOTOS_SCENE_ROUTES_JSON={"场景一":{"resource":"voice.photo.scene1","measurementField":"转速","acceptedUnits":["rpm"],"valueType":"number","staticFields":{"批次":"测试版本"}},"场景二":{"resource":"voice.photo.scene2","measurementField":"无水氯化铜（克）","acceptedUnits":["g","克"],"valueType":"number","staticFields":{"批次":"测试版本","设备仪器":"链路测试"}},"环境":{"resource":"voice.photo.environment","measurementField":"温度","acceptedUnits":["℃","°C","C"],"valueType":"text-with-unit","staticFields":{"批次":"测试版本"}}}

# Configure the exact same random value in FEISHU_BITABLE_RESOURCES_JSON.
VOICE_PHOTOS_MACHINE_INGEST_HMAC_KEY=replace-with-a-random-secret-at-least-32-characters

VOICE_PHOTOS_POLL_INTERVAL_MS=5000
VOICE_PHOTOS_STABILITY_SCANS=2
VOICE_PHOTOS_MAX_JSON_BYTES=1048576
VOICE_PHOTOS_MAX_CANDIDATES_PER_SCAN=10000
VOICE_PHOTOS_MAX_IMAGE_BYTES=20971520
VOICE_PHOTOS_DELIVERY_CONCURRENCY=1
VOICE_PHOTOS_MAX_SENDS_PER_MINUTE=30
VOICE_PHOTOS_RETRY_BASE_MS=1000
VOICE_PHOTOS_RETRY_MAX_MS=300000
VOICE_PHOTOS_SENDING_LEASE_MS=60000
VOICE_PHOTOS_OWNER_LEASE_MS=30000
