# The bridge is inert unless all three switches are exactly "true".
XIAOHUAN_BITABLE_BRIDGE_ENABLED=false
XIAOHUAN_BITABLE_ALLOW_EXTERNAL_UPLOAD=false
XIAOHUAN_BITABLE_ALLOW_AGENT_DELIVERY=false

# Trusted operator binding. FEISHU_APP_ID is the same Host app scope used by
# the native Feishu adapter; startup cross-checks it, the fixed DM open_id and
# the canonical user against Host user_identities before accepting audio.
# FEISHU_APP_ID=cli_replace_me
XIAOHUAN_BITABLE_AUTHENTICATED_USER_ID=canonical-user-replace-me
XIAOHUAN_BITABLE_FEISHU_P2P_PLATFORM_ID=feishu:p2p:ou_replace_me
# Explicitly mirror only the concise "语音指令：..." text to that same fixed DM.
XIAOHUAN_BITABLE_FEISHU_TRANSCRIPT_MIRROR_ENABLED=false

# Gateway logical alias and deterministic experiment-audio.v1 source mapping.
# Never place app_token, table_id, tenant tokens, or Feishu credentials here.
XIAOHUAN_BITABLE_RESOURCE=pilot.records
# String values are shorthand. Selector objects create preliminary deterministic
# candidates. text-after-marker reads one bounded transcript phrase after an
# operator-configured exact marker; units are never guessed or converted.
XIAOHUAN_BITABLE_FIELD_MAP_JSON={"transcript":{"field":"Batch","selector":"text-after-marker","markers":["batch"]},"experiment.actions":{"field":"Device","selector":"action-target","name":"use"},"experiment.measurements":{"field":"Mass (g)","selector":"measurement-value","name":"mass","unit":"g"}}
XIAOHUAN_BITABLE_JOIN_SEPARATOR=" | "
XIAOHUAN_BITABLE_MAX_FIELD_VALUE_BYTES=8192

# Hardware sends one complete PCM WAV per POST after local wake/endpointing.
XIAOHUAN_BITABLE_HTTP_BIND=0.0.0.0
XIAOHUAN_BITABLE_HTTP_PORT=50020
XIAOHUAN_BITABLE_HTTP_MAX_BODY_BYTES=4194304
XIAOHUAN_BITABLE_HTTP_MAX_DURATION_MS=61000
XIAOHUAN_BITABLE_HTTP_MAX_QUEUE=8
XIAOHUAN_BITABLE_HTTP_REQUEST_TIMEOUT_MS=10000
XIAOHUAN_BITABLE_KEEP_UTTERANCES=false
# XIAOHUAN_BITABLE_HTTP_OUTPUT_DIR=/private/tmp/xiaohuan-bitable

# Ark extractor configuration reused by the bridge.
DOUBAO_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_ARK_API_KEY=replace_me
DOUBAO_ARK_MODEL=doubao-seed-2-0-lite-260428
DOUBAO_REQUEST_TIMEOUT_MS=120000
DOUBAO_WAV_MAX_BYTES=4194304
DOUBAO_WAV_MAX_DURATION_MS=61000
