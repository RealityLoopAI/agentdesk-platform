# The bridge is inert unless all three switches are exactly "true".
XIAOHUAN_BITABLE_BRIDGE_ENABLED=false
XIAOHUAN_BITABLE_ALLOW_EXTERNAL_UPLOAD=false
XIAOHUAN_BITABLE_ALLOW_AGENT_DELIVERY=false

# Trusted operator binding. Use a canonical Host user and that user's Feishu DM.
XIAOHUAN_BITABLE_AUTHENTICATED_USER_ID=canonical-user-replace-me
XIAOHUAN_BITABLE_FEISHU_P2P_PLATFORM_ID=feishu:p2p:ou_replace_me

# Gateway logical alias and deterministic experiment-audio.v1 source mapping.
# Never place app_token, table_id, tenant tokens, or Feishu credentials here.
XIAOHUAN_BITABLE_RESOURCE=pilot.records
# String values are shorthand. Selector objects create preliminary exact-match
# candidates; unresolved values remain available to evidence-bounded Worker
# normalization against the live Field List. Units are never guessed/converted.
XIAOHUAN_BITABLE_FIELD_MAP_JSON={"captureId":"Capture ID","transcript":"Transcript","experiment.actions":{"field":"Device","selector":"action-target","name":"use"},"experiment.measurements":{"field":"Mass (g)","selector":"measurement-value","name":"mass","unit":"g"}}
XIAOHUAN_BITABLE_JOIN_SEPARATOR=" | "
XIAOHUAN_BITABLE_MAX_FIELD_VALUE_BYTES=8192

# Optional offline acknowledgement after the matching Host Create confirmation
# card is successfully delivered. Trusted-LAN private IPv4 only; no credentials.
XIAOHUAN_BITABLE_TTS_ACK_ENABLED=false
XIAOHUAN_BITABLE_TTS_BASE_URL=http://192.168.66.133:18082
XIAOHUAN_BITABLE_TTS_ACK_TEXT=收到
XIAOHUAN_BITABLE_TTS_TIMEOUT_MS=2000

# Existing Xiaohuan RTP/VAD service parameters.
XIAOHUAN_BITABLE_SDP_PATH=../xiaohuan-doubao-audio/xiaohuan-realtime-macos.sdp
XIAOHUAN_BITABLE_FFMPEG_PATH=ffmpeg
XIAOHUAN_BITABLE_VAD_THRESHOLD_DB=-43
XIAOHUAN_BITABLE_VAD_FRAME_MS=20
XIAOHUAN_BITABLE_VAD_START_FRAMES=5
XIAOHUAN_BITABLE_VAD_PRE_ROLL_MS=300
XIAOHUAN_BITABLE_VAD_TRAILING_SILENCE_MS=800
XIAOHUAN_BITABLE_VAD_MIN_SPEECH_MS=400
XIAOHUAN_BITABLE_VAD_MAX_UTTERANCE_MS=20000
XIAOHUAN_BITABLE_MAX_QUEUE=4
XIAOHUAN_BITABLE_FIRST_AUDIO_TIMEOUT_MS=30000
XIAOHUAN_BITABLE_STOP_GRACE_MS=3000
XIAOHUAN_BITABLE_CAPTURE_PREFIX=xiaohuan-bitable
XIAOHUAN_BITABLE_NORMALIZE_PEAK_DB=-3
XIAOHUAN_BITABLE_MAX_NORMALIZE_GAIN_DB=30
XIAOHUAN_BITABLE_KEEP_UTTERANCES=false
# XIAOHUAN_BITABLE_OUTPUT_DIR=/private/tmp/xiaohuan-bitable

# Existing Ark extractor configuration reused by the bridge.
DOUBAO_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_ARK_API_KEY=replace_me
DOUBAO_ARK_MODEL=doubao-seed-2-0-lite-260428
DOUBAO_REQUEST_TIMEOUT_MS=60000
DOUBAO_WAV_MAX_BYTES=10485760
DOUBAO_WAV_MAX_DURATION_MS=20000
