# Host path to an OS-mounted read-only view; never put SMB credentials here.
VISION_ARCHIVE_ROOT=/mnt/visioncortex-video/VisionCortexExperimentArchive
VISION_ARCHIVE_READ_ENABLED=false
VISION_ARCHIVE_RESOURCES_JSON={"vision":{"readers":["canonical-user-id"],"agentGroups":["archive-worker-agent-group-id"],"categories":["关键帧","关键片段","专业报告","结构化数据"]}}
VISION_ARCHIVE_MAX_JSON_BYTES=2097152
VISION_ARCHIVE_MAX_RESULTS=100
VISION_ARCHIVE_OPERATION_TIMEOUT_MS=10000
VISION_ARCHIVE_GATEWAY_PORT=8090
# Inject a dedicated random value from a secret manager.
GATEWAY_SIGNING_KEY=
