# Gateway process only. Never copy these values into an Agent group,
# container.json, Prompt, Web bundle, or Channel configuration.
FEISHU_BITABLE_APP_ID=cli_replace_me
FEISHU_BITABLE_APP_SECRET=replace_me
FEISHU_BITABLE_CURSOR_SECRET=replace_with_at_least_32_random_characters
FEISHU_BITABLE_CONFIRMATION_SECRET=replace_with_at_least_32_random_characters

# Enable Read first. Enable Write only after the read smoke test passes.
FEISHU_BITABLE_READ_ENABLED=true
FEISHU_BITABLE_WRITE_ENABLED=false

# One low-risk pilot table. Replace physical IDs and field names outside Git.
# "*" means any non-empty canonical user identity trusted by the Host session.
# Query uses record.list's structured query/orderBy contract. Single Delete is
# confirmation- and fingerprint-bound; every Batch operation remains absent.
FEISHU_BITABLE_RESOURCES_JSON={"pilot.records":{"appToken":"bas_replace_me","tableId":"tbl_replace_me","name":"Bitable pilot","readers":["*"],"writers":["*"],"requiredFields":["Title"],"allowedOperations":["feishu.bitable.field.list","feishu.bitable.record.list","feishu.bitable.record.get","feishu.bitable.record.create","feishu.bitable.record.update","feishu.bitable.record.delete"]}}
